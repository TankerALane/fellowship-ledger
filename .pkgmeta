# Fellowship Ledger does NOT use the BigWigs packager.
#
# The packager names the package from a TOC in the repository root, and this repo
# keeps the addon in FellowshipLedger/ (a layout chosen up front). Releases are
# built by tools/build_release.py instead, run by .github/workflows/release.yml on
# a version tag (see docs/RELEASING.md and docs/DECISIONS.md D-052).
#
# This file is kept so packager-based tooling that looks for it finds an answer.
# If the repo is ever flattened, these settings would package it correctly:
package-as: FellowshipLedger

ignore:
  - assets
  - docs
  - tests
  - tools
  - dist
  - .github
  - CLAUDE.md
  - CLAUDE_CODE_PROMPT.md
